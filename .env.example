# Binance API Keys
# Get testnet keys from: https://testnet.binance.vision/
# Get live keys from: https://www.binance.com/en/my/settings/api-management

BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Mode: "paper" (testnet) or "live" (real money - USE WITH CAUTION)
TRADING_MODE=paper

# Risk Management
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.05

# Capital allocated for bot (in USDT)
TRADING_CAPITAL=1000
